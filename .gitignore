# Never commit game binaries (copyright + size).
bin_linux/
bin_win/
bin_prev/
*.so
*.dll
# DepotDownloader session cache + manifest/depot staging dir.
.DepotDownloader/
depots/
# Python bytecode.
__pycache__/
*.pyc
# Secrets + cron log.
.env
reports/cron.log
# Per-run scratch for the Discord report: the named delta handed from
# post_gate.py to post_discord.py, and the fragility counts from gen_stats.py.
# Both are derived from committed data - regenerated every run, never tracked.
reports/delta.json
reports/fragility.json
reports/reference_gaps.json
# The gameVersion + configSha256 that poll_latest.py saw on sig.miksen.me last
# tick. Machine-local like the Discord state: it records what THIS host has
# already reacted to, and a shared copy would make one host swallow the other's
# trigger.
reports/.last_seen.json
# Which Discord message the last run posted, per webhook (hashed, never the URL
# itself). Local to whichever machine runs the pipeline - a shared copy would
# make two hosts fight over the same message.
reports/discord_state.json
# Private development rules — not for public repo.
CLAUDE.md
hm

# Reference snapshots: re-fetchable and sha256-verified, a few MB each.
# Drop these two lines if you want the reference history committed.
data/symbols/

# VPS-local upstream build poller (crontab) and its state
/.last_seen
/.poll.lock
/poll.log
/scripts/poll_upstream_build.sh
