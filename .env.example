# Copy to .env on the VPS and fill in. .env is git-ignored — never commit it.
#   cp .env.example .env && nano .env

# GitHub PAT with Contents:read on any PRIVATE repo listed in data/projects.json
# (e.g. the mrc4tt/CounterStrikeSharp fork). Public projects fetch without it.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# Path to the DepotDownloader binary (not on PATH in your setup).
DEPOTDOWNLOADER=/root/depotdownloader/DepotDownloader

# Commit author for auto-pushed results (optional).
GIT_NAME=sig-tracker
GIT_EMAIL=sig-tracker@localhost

# Optional Steam login (anonymous works; leave unset unless needed).
# STEAM_USER=
# STEAM_PASS=

# Optional Forgejo integration, used for two things:
#   1. auto-open/close an issue when a signature breaks (across all projects)
#   2. publish the CS2 server binaries as release assets (scripts/publish_bins.py)
# Leave unset to disable both. Token needs write:repository (releases + tags) and
# write:issue if you also want the auto-issue.
# FORGEJO_TOKEN=
# FORGEJO_SERVER=https://git.miksen.me
# FORGEJO_REPO=mikkel/cs2-signatures

# Optional: how many recent binary releases to keep (default 2). Older
# tracker-managed releases are pruned each run.
# BINS_KEEP=2

# Optional: path to a steamcmd appmanifest_730.acf. When set, its Steam buildid
# becomes the binary release tag; otherwise the tag is the CS2 PatchVersion from
# steam.inf (e.g. bins-1.41.6.9).
# APPMANIFEST=/path/to/steamapps/appmanifest_730.acf

# Optional: post a signature report to a Discord webhook on each real change.
# Leave unset to disable. The default is a per-signature card that auto-falls
# back to one card per project when too large; --summary forces the compact
# card. Preview without sending (no URL needed):
#   python3 scripts/post_discord.py --preview            # current status
#   python3 scripts/post_discord.py --preview --example  # synthetic broken data
#   python3 scripts/post_discord.py --example            # live test post
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY
# Optional: ping someone when a sig breaks/goes ambiguous. Use a NUMERIC user id
# (Discord > Developer Mode > right-click name > Copy User ID), or 'here'/
# 'everyone'. Plain "@name" text does NOT notify. No ping when all sigs pass.
# DISCORD_MENTION=123456789012345678
